# Revalidate mutable Terminal and shared runtime assets on every visit.
# Images, textures, audio and vendor libraries retain their normal caching.
/terminal/*.js
  Cache-Control: public, max-age=0, must-revalidate
/terminal/*.css
  Cache-Control: public, max-age=0, must-revalidate
/shared/*.js
  Cache-Control: public, max-age=0, must-revalidate
/shared/*.css
  Cache-Control: public, max-age=0, must-revalidate
