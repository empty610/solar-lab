# Only build-generated, content-addressed JS/CSS URLs are immutable.
/shared/cache/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and legacy JS/CSS URLs may change in place and must revalidate.
/*.html
  Cache-Control: public, no-cache, max-age=0, must-revalidate
